# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shogun_waitlist

# The public count starts from the existing audience, then adds rows saved by
# the current waitlist. Keep this separate from the storage row count.
WAITLIST_DISPLAY_BASE=468

# --- Referral engine ---
# Public origin used to build share links and status URLs.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Logo.dev token for rendering official partner / ecosystem logos in the LP.
# Set as a Cloudflare Worker secret, never a NEXT_PUBLIC_* build variable.
LOGO_DEV_TOKEN=

# Comma-separated list of allowed Origin headers for public POSTs.
WAITLIST_ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for server-to-server signup (e.g. webhook). Optional.
WAITLIST_WEBHOOK_SECRET=

# Salt for hashing signup IPs (referral-fraud detection). Set a long random value.
WAITLIST_IP_SALT=change-me-to-a-long-random-string

# --- Gamification / points (X social awards) ---
# Monitored X accounts + launch tweet for follow/quote awards.
X_PRODUCT_ACCOUNT=shogun
X_FOUNDER_ACCOUNT=shogun_founder
X_LAUNCH_TWEET_ID=

# twscrape bridge (server-to-server). Both required to enable X sync.
X_BRIDGE_URL=
X_BRIDGE_TOKEN=

# --- Admin dashboard / X-sync trigger ---
# Sent as the `x-admin-token` header. MUST be >= 16 chars or the admin
# endpoints deny every request. Use a long random value.
ADMIN_TOKEN=

# ── Billing (issue #8) ────────────────────────────────────────────────────────
# Checkout stays disabled (503) until the key AND all four prices are set: the app offers
# standard/pro x annual/monthly, and a half-configured environment breaks one of those paths.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
# Card-on-file trial days added by Stripe (FR-BIL-06). 0 = charge now; the product's own 7-day
# trial is enforced locally by the Rust core either way.
STRIPE_TRIAL_DAYS=0
# Set to 1 only after the dashboard is configured — origin address, product tax code, and a
# tax_behavior on all four Prices. See docs/stripe-tax-setup.md; with the flag on and the account
# unconfigured, every Checkout session fails.
STRIPE_AUTOMATIC_TAX=
# Absolute origin for Checkout/Portal return URLs, read at runtime. Set this on the Worker, not
# at build time — NEXT_PUBLIC_APP_ORIGIN is inlined during the build and the deploy workflow does
# not set it. Defaults to the production domain when unset.
APP_ORIGIN=https://shogunaios.com
# Ed25519 signing key for licence tokens (scripts/gen-license-keypair.mjs). Secret.
LICENSE_SIGNING_KEY=

# ── Support intake notifications (CS窓口) ────────────────────────────────────
# Resend API key. UNSET = notifications are OFF and reports land in the database only —
# a supported state (local dev / preview), never an error. Set it in production or nobody
# is told a report arrived. Secret.
RESEND_API_KEY=
# Where notifications go, and the envelope sender. Both default to info@shogunaios.com.
# SUPPORT_NOTIFY_FROM must be on a domain verified in Resend (SPF/DKIM) or every send is
# rejected — that is the field most likely to be wrong on the first deploy.
SUPPORT_NOTIFY_TO=
SUPPORT_NOTIFY_FROM=
