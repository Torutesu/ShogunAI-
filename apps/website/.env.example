# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shogun_waitlist

# The public count starts from the existing audience, then adds rows saved by
# the current waitlist. Keep this separate from the storage row count.
WAITLIST_DISPLAY_BASE=468

# --- Referral engine ---
# Public origin used to build share links and status URLs.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Logo.dev token for rendering official partner / ecosystem logos in the LP.
# Set as a Cloudflare Worker secret, never a NEXT_PUBLIC_* build variable.
LOGO_DEV_TOKEN=

# Comma-separated list of allowed Origin headers for public POSTs.
WAITLIST_ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for server-to-server signup (e.g. webhook). Optional.
WAITLIST_WEBHOOK_SECRET=

# Salt for hashing signup IPs (referral-fraud detection). Set a long random value.
WAITLIST_IP_SALT=change-me-to-a-long-random-string

# --- Gamification / points (X social awards) ---
# Monitored X accounts + launch tweet for follow/quote awards.
X_PRODUCT_ACCOUNT=shogun
X_FOUNDER_ACCOUNT=shogun_founder
X_LAUNCH_TWEET_ID=

# twscrape bridge (server-to-server). Both required to enable X sync.
X_BRIDGE_URL=
X_BRIDGE_TOKEN=

# --- Admin dashboard / X-sync trigger ---
# Sent as the `x-admin-token` header. MUST be >= 16 chars or the admin
# endpoints deny every request. Use a long random value.
ADMIN_TOKEN=
