# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shogun_waitlist

# --- Referral engine ---
# Public origin used to build share links and status URLs.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Comma-separated list of allowed Origin headers for public POSTs.
# FAIL CLOSED when unset: only same-origin requests are accepted (local
# `next dev` keeps working). Set explicitly in production.
WAITLIST_ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for server-to-server signup (e.g. webhook). Optional.
WAITLIST_WEBHOOK_SECRET=

# Salt for hashing signup IPs (referral-fraud detection). Set a long random value.
WAITLIST_IP_SALT=change-me-to-a-long-random-string

# --- Billing / Stripe (issue #8) ---
# Secret key (sk_test_… in test mode). Absent = every billing route answers 503
# and the LP falls back to the waitlist CTA; the site itself keeps working.
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint (whsec_…). Signature verification is
# mandatory — an unset value makes /api/stripe/webhook return 500, never bypass.
STRIPE_WEBHOOK_SECRET=

# Price IDs, per plan × interval. These NEVER reach the browser: the client asks
# for a plan name and the server resolves the price (anti-tamper).
# Amounts (2026-08-10): Standard $588/yr = $49/mo · $62/mo · Pro $1188/yr = $99/mo · $124/mo
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=

# Extra trial days granted by Stripe Checkout (FR-BIL-06 flag). 0 = the local
# 7-day trial is the only trial; 7 = a card-on-file-but-not-charged LP funnel.
STRIPE_TRIAL_DAYS=0

# Show real Checkout buttons on the LP pricing section. Unset = waitlist CTA.
NEXT_PUBLIC_BILLING_ENABLED=

# Ed25519 private key that signs licence tokens, as base64(PKCS#8 PEM).
# Generate with: node scripts/gen-license-keypair.mjs
# SECRET — licence-API environment only, never in a client bundle or the repo.
LICENSE_SIGNING_KEY=
