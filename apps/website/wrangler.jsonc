{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shogunai-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "shogunai-website-codex-preview",
      "vars": {
        "WAITLIST_ALLOWED_ORIGINS": "https://shogunaios.com,https://www.shogunaios.com"
      },
      // Postgres reached through Cloudflare's network instead of a raw socket. The Worker's
      // `nodejs_compat` socket shim cannot reliably reach Supabase's pooler — roughly half of all
      // database calls came back `proxy request failed, cannot connect to the specified address`
      // — and Hyperdrive is the supported way off that shim. `src/db/index.ts` prefers this
      // binding and falls back to DATABASE_URL wherever it is absent (next dev, tests, migrate).
      //
      // Query caching is deliberately OFF on the config itself: this database holds licence
      // validity and subscription status, and a cached read means a revoked licence keeps
      // verifying until the entry expires. The value here is the connection, not the cache.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "c8c81f7f1452481497c4690fb9d5db65"
        }
      ],
      "d1_databases": [
        {
          "binding": "WAITLIST_METRICS",
          "database_name": "shogunai-waitlist-metrics",
          "database_id": "02a3448d-ec1c-4c47-8b3e-8d61c01851d2"
        }
      ],
      "routes": [
        {
          "pattern": "shogunaios.com",
          "custom_domain": true
        },
        {
          "pattern": "www.shogunaios.com",
          "custom_domain": true
        }
      ]
    }
  }
  // Secrets (set in the Cloudflare dashboard or `wrangler secret put`):
  //   DATABASE_URL        — Supabase connection string (session pooler).
  //                         Set this on every Worker that should show the
  //                         live waitlist count and accept registrations.
  // For lower DB latency from Workers, bind Cloudflare Hyperdrive to Supabase
  // and point DATABASE_URL at the Hyperdrive connection string. See DEPLOY.md.
}
