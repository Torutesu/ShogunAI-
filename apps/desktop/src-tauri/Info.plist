<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Accessory / agent app: no Dock icon, background overlay. Declaring this in the bundle's
         Info.plist (not just at runtime) is what lets the notch panel actually join every Space and
         draw over full-screen apps — the runtime setActivationPolicy is honored for the Dock icon
         but the window-server treats an unbundled dev process differently for Space management. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSScreenCaptureUsageDescription</key>
    <string>SHOGUN reads the focused window only when you turn on Visual recall, runs on-device text recognition, and never saves screenshots.</string>
</dict>
</plist>
