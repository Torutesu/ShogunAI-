{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHOGUN Spike",
  "version": "0.0.0",
  "identifier": "dev.shogun.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "title": "SHOGUN",
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "width": 400,
        "height": 560,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}