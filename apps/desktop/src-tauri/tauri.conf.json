{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHOGUN Spike",
  "version": "0.0.0",
  "identifier": "dev.shogun.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "title": "SHOGUN",
        "transparent": false,
        "decorations": true,
        "resizable": true,
        "alwaysOnTop": false,
        "shadow": true,
        "width": 820,
        "height": 600,
        "minWidth": 480,
        "minHeight": 420,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}