{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHOGUN Spike",
  "version": "0.0.0",
  "identifier": "dev.shogun.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "title": "SHOGUN",
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": false,
        "shadow": false,
        "width": 432,
        "height": 188,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "comment": "Phase 0 runs via `tauri dev` / unsigned release only; no bundling/notarization (spec §2.2)."
  }
}
