<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lets a stable signing identity share Keychain access across rebuilds when paired with
         codesign (see scripts/codesign-desktop-dev.sh). -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.syogun.shogunai</string>
    </array>
</dict>
</plist>
